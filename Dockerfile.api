# syntax=docker/dockerfile:1
# 后端镜像（多阶段）：builder 装依赖 + prisma generate + tsc 编译；runtime 仅运行。
# 构建上下文 = 仓库根目录，故所有 COPY 路径都带 backend/ 前缀。
#   docker build -f Dockerfile.api -t portfolio-api .
# 运行时环境变量（AUTH_SECRET / ADMIN_PASSWORD_HASH / ADMIN_USERNAME）一律由
# docker-compose 的 env_file 注入，不写入镜像层，也不写进镜像 ENV。

# ---------- builder ----------
FROM node:22-alpine AS builder
WORKDIR /app

# prisma 引擎在 alpine 上依赖 openssl
# prisma 引擎需要 libssl3（node:22-alpine 基础镜像已自带 libssl.so.3 / libcrypto.so.3）；
# `openssl` 包只是 CLI 兜底。私有部署/受限网络里 Alpine CDN 常常不可达，拉不到就跳过，
# 不让镜像构建因为一个非必需包直接失败（见 docs/deployment.md §11.1）。
# 装了就在镜像里留一个标记；没装成功则容器启动时明确声明降级（容错不等于静默）。
RUN (apk add --no-cache openssl && touch /app/.openssl-cli   || echo "WARN: openssl 包安装失败，使用基础镜像自带 libssl3（prisma 引擎可用）")

COPY backend/package.json backend/package-lock.json ./
RUN npm ci

COPY backend/prisma ./prisma
# 生成 @prisma/client 到 node_modules/.prisma（随 node_modules 一起进入 runtime）
RUN npx prisma generate

COPY backend/tsconfig.json ./
COPY backend/src ./src
RUN npm run build

# ---------- runtime ----------
FROM node:22-alpine AS runtime
WORKDIR /app

# 非 root：使用镜像内置的 node（uid/gid 1000）；/data 为 SQLite 命名卷挂载点
# 装了就在镜像里留一个标记；没装成功则容器启动时明确声明降级（容错不等于静默）。
RUN (apk add --no-cache openssl && touch /app/.openssl-cli   || echo "WARN: openssl 包安装失败，使用基础镜像自带 libssl3（prisma 引擎可用）") \
  && mkdir -p /data \
  && chown -R node:node /data

ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0 \
    DATABASE_URL=file:/data/prod.db

# node_modules 含 prisma CLI（devDependency），启动时用它跑 migrate deploy；
# 影像略大但避免运行期联网下载引擎，迁移与应用版本始终一致。
COPY --from=builder --chown=root:root /app/package.json /app/package-lock.json ./
COPY --from=builder --chown=root:root /app/node_modules ./node_modules
COPY --from=builder --chown=root:root /app/prisma ./prisma
COPY --from=builder --chown=root:root /app/dist ./dist

USER node
EXPOSE 3000

# 先迁移再起服务：迁移失败则容器启动失败（不会带着旧 schema 提供服务）
# 启动第一件事：openssl CLI 缺失时打一行显式降级声明。
#   - 运行时不依赖 openssl 命令：prisma 引擎用基础镜像自带的 libssl.so.3，口令摘要用 node:crypto（scrypt）；
#   - openssl 只在宿主/CI 里用于 `openssl rand -base64 48` 生成密钥，与容器内功能无关。
CMD ["sh", "-c", "[ -f /app/.openssl-cli ] || echo '[openssl] 未安装 openssl CLI，依赖它的兜底功能降级：运行时只使用 libssl（prisma 引擎）与 node:crypto（scrypt 口令摘要），不受影响'; npx prisma migrate deploy && exec node dist/index.js"]
