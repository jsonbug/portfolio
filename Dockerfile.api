# syntax=docker/dockerfile:1
# 后端镜像（多阶段）：builder 装依赖 + prisma generate + tsc 编译；runtime 仅运行。
# 构建上下文 = 仓库根目录，故所有 COPY 路径都带 backend/ 前缀。
#   docker build -f Dockerfile.api -t portfolio-api .
# 运行时环境变量（AUTH_SECRET / ADMIN_PASSWORD_HASH / ADMIN_USERNAME）一律由
# docker-compose 的 env_file 注入，不写入镜像层，也不写进镜像 ENV。

# ---------- builder ----------
FROM node:22-alpine AS builder
WORKDIR /app

# prisma 引擎真正依赖的是 libssl3（node:22-alpine 基础镜像自带 libssl.so.3 / libcrypto.so.3）。
# 这条**不放行**：基础镜像哪天不再自带 libssl3，镜像必须构建失败，而不是等到容器里 prisma 崩。
# 注：`openssl` **CLI** 不是运行时依赖——应用与 prisma 引擎都不调用它，只有
# docs/deployment.md 里「openssl rand 生成密钥」那条人工命令用到，在宿主上执行即可，
# 镜像里不装（装了也没有任何功能依赖它，为它写「降级声明」等于写假话）。
RUN test -e /usr/lib/libssl.so.3 || (echo '缺少 libssl.so.3：prisma 引擎无法运行，拒绝构建' && exit 1)

COPY backend/package.json backend/package-lock.json ./
RUN npm ci

COPY backend/prisma ./prisma
# 生成 @prisma/client 到 node_modules/.prisma（随 node_modules 一起进入 runtime）
RUN npx prisma generate

COPY backend/tsconfig.json ./
COPY backend/src ./src
RUN npm run build

# ---------- runtime ----------
FROM node:22-alpine AS runtime
WORKDIR /app

# 非 root：使用镜像内置的 node（uid/gid 1000）；/data 为 SQLite 命名卷挂载点
# 运行时真正的前提：libssl3 存在（缺了直接构建失败，见 builder 阶段同一条断言）
RUN test -e /usr/lib/libssl.so.3 || (echo '缺少 libssl.so.3：prisma 引擎无法运行，拒绝构建' && exit 1) \
  && mkdir -p /data \
  && chown -R node:node /data

ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0 \
    DATABASE_URL=file:/data/prod.db

# node_modules 含 prisma CLI（devDependency），启动时用它跑 migrate deploy；
# 影像略大但避免运行期联网下载引擎，迁移与应用版本始终一致。
COPY --from=builder --chown=root:root /app/package.json /app/package-lock.json ./
COPY --from=builder --chown=root:root /app/node_modules ./node_modules
COPY --from=builder --chown=root:root /app/prisma ./prisma
COPY --from=builder --chown=root:root /app/dist ./dist

USER node
EXPOSE 3000

# 先迁移再起服务：迁移失败则容器启动失败（不会带着旧 schema 提供服务）
# 运行时不依赖 openssl CLI：prisma 引擎用基础镜像自带的 libssl.so.3，口令摘要用 node:crypto（scrypt）。
CMD ["sh", "-c", "npx prisma migrate deploy && exec node dist/index.js"]
