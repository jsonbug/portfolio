# HTTP 服务
PORT=3000
HOST=0.0.0.0

# SQLite 数据库文件（路径相对于 prisma/ 目录）
DATABASE_URL="file:./dev.db"

# 登录认证（2.1，单管理员）
# 生产环境必须显式设置 AUTH_SECRET 与 ADMIN_PASSWORD_HASH
# ADMIN_PASSWORD_HASH 用 `node scripts/hash-password.mjs <明文口令>` 生成（scrypt）
AUTH_SECRET=change-me-to-a-long-random-secret
AUTH_TTL_SECONDS=604800
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$0c018e1a47e4503e5f8b52c79cb7f7f9$6286fb06632109c6e98a2f5e2b3799290883f88ae4a17db8c35a6606a8e2fdb6dc330f7631437a77660a1a9fcf63993f54d55d5c6391f5919f17cdb8767198db

# 链接健康检查（B16）
# 保存链接 / 改 url 后异步检查；POST /admin/links/:id/check 立即重检
# LINK_CHECK_ENABLED=0 关闭保存后的自动检查（手动重检仍然可用）
LINK_CHECK_ENABLED=1
# 单跳超时（毫秒，连接 + 响应头）
LINK_CHECK_TIMEOUT_MS=5000
# 整体超时（毫秒，含全部重定向跳）
LINK_CHECK_TOTAL_TIMEOUT_MS=8000
# 最多跟随的重定向跳数（每跳重新解析 + SSRF 重校验）
LINK_CHECK_MAX_REDIRECTS=3
