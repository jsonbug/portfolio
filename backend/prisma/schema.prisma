// 项目展示平台 · 数据模型
// SQLite (MVP) —— 预留平滑迁移 PostgreSQL/Supabase
//
// 迁移友好设计：
//  1. 主键统一用 cuid() 字符串，不依赖 SQLite 自增整型，切到 Postgres 无需改 ID 类型；
//  2. 不使用 Prisma 原生 enum（SQLite 不支持，会退化为 TEXT），枚举值用 String + 应用层校验（src/contract/schemas.ts）；
//  3. 表名/字段名用 @@map 固定为 snake_case，避免 Postgres 标识符折叠差异；
//  4. 时间统一 DateTime，SQLite 存 ISO/数值、Postgres 存 timestamp，Prisma 层语义一致。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 项目（核心实体）
model Project {
  id                 String    @id @default(cuid())
  name               String // 项目名称（必填，1..100）
  tagline            String? // 一句话简介（列表卡片摘要）
  description        String? // 详细描述（Markdown）
  coverImage         String? // 封面图 URL（http/https ≤2048，可选；null=渐层兜底）
  status             String    @default("draft") // 发布状态：draft | published | archived
  stars              Int? // star 数（后台手填，P0）
  lastActivityAt     DateTime? // 项目更新时间（后台手填，P0，语义=项目外部最后活跃时间）
  role               String? // 元数据·角色
  projectStatus      String? // 元数据·项目状态：active | completed | maintained | paused
  startDate          DateTime? // 元数据·时间范围起
  endDate            DateTime? // 元数据·时间范围止
  githubRepo         String? // 预留·GitHub 仓库全名 owner/repo（P1 自动拉取）
  githubStars        Int? // 预留·P1 自动拉取的 star
  githubLastActivityAt DateTime? // 预留·P1 自动拉取的更新时间
  githubSyncedAt     DateTime? // 预留·P1 上次同步时间
  deletedAt          DateTime? // 软删除标记（非空=已删除，前台与后台列表均不可见）
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  note         Note?
  links        Link[]
  technologies ProjectTechnology[]

  @@index([status, deletedAt])
  @@index([name])
  @@map("project")
}

// 技术栈标签（多值元数据，前台筛选 F6 依赖）
model Technology {
  id       String              @id @default(cuid())
  name     String              @unique // 技术栈名，如 "Vue" / "Node.js"（1..50，唯一）
  projects ProjectTechnology[]

  @@map("technology")
}

// 项目 ↔ 技术栈 关联表（显式建模，级联规则明确）
model ProjectTechnology {
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId])
  @@map("project_technology")
}

// 链接（1:N 项目）
model Link {
  id        String   @id @default(cuid())
  projectId String
  type      String   @default("other") // repo | website | demo | other
  label     String? // 显示名，如 "GitHub" / "官网"
  url       String // 链接地址（应用层校验 http/https）
  sortOrder Int      @default(0) // 展示排序，越小越靠前
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("link")
}

// 笔记（1:1 项目，纯 Markdown）
// 冻结决策为「一项目一笔记」；若后续要改 1:N，仅需去掉 projectId 的 @unique，无需数据迁移。
model Note {
  id        String   @id @default(cuid())
  projectId String   @unique
  title     String // 标题（1..200）
  content   String // 正文，纯 Markdown（1..100000 字符）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("note")
}
