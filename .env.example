# 根级部署环境变量（docker compose 用）—— cp .env.example .env 后填写真实值
# ⚠️ .env 已被 .gitignore 忽略，绝不提交；密钥只在运行时经 env_file 注入容器，不进入镜像层。
# ⚠️ ADMIN_PASSWORD_HASH 含 `$`，compose 会打印 "variable is not set" 警告——
#    docker-compose.yml 用 env_file format: raw 原样注入，该警告可忽略（校验命令见 docs/deployment.md §9）。

# ---------- 认证（必填，缺一项 api 容器会启动失败） ----------

# JWT 签名密钥：≥32 字符的随机串。生成方式：
#   openssl rand -base64 48
AUTH_SECRET=

# 管理员账号
ADMIN_USERNAME=admin

# 管理员口令的 scrypt 摘要（不存明文）。生成方式：
#   node backend/scripts/hash-password.mjs '你的口令'
# 输出形如 scrypt$<saltHex>$<hashHex>，整行粘贴到下面
ADMIN_PASSWORD_HASH=

# 登录令牌有效期（秒），默认 7 天
AUTH_TTL_SECONDS=604800

# ---------- web 端口 ----------

# 宿主映射端口（默认 8080；被占用时改成 8180 等）
WEB_PORT=8080

# 前置反代落地 HTTPS 后可收紧为只监听回环，避免绕过 TLS 直连：
# WEB_PORT=127.0.0.1:8080

# ---------- 链接健康检查（B16，可选） ----------
# 不填就用默认值。保存链接/改 URL 时异步检查，后台可手动重检（POST /admin/links/:id/check）。
# LINK_CHECK_ENABLED=1             # 0/false 关掉自动检查（手动重检仍可用）
# LINK_CHECK_TIMEOUT_MS=5000      # 单跳超时
# LINK_CHECK_TOTAL_TIMEOUT_MS=8000 # 含重定向的整体预算
# LINK_CHECK_MAX_REDIRECTS=3      # 重定向跳数上限（每跳重新校验目标 IP）
#
# ⚠️ 启动时会校验 AUTH_SECRET（≥ 32 字节、不能用 dev 占位串）与 ADMIN_PASSWORD_HASH 格式，
#    填错直接拒绝启动并打印原因——比带着坏配置对外服务（登录永远 401）好排查。
